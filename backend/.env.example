# IntelliVet Environment Variables

# Application
PROJECT_NAME="IntelliVet API"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
SECRET_KEY="temporary-dev-secret-key-change-in-production-long-random-string"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Default: async SQLite for fast local development out of the box
DATABASE_URL="sqlite+aiosqlite:///./intellivet.db"
# For PostgreSQL:
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/intellivet"

# External Services
OPENAI_API_KEY=""
SMS_PROVIDER="mock"  # "mock" or "provider_name"
SMS_API_KEY=""

